// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  createdAt DateTime @default(now())
}

// 게시판 회원
model User {
  id        Int         @id @default(autoincrement())
  affil     String      // 소속 (예: 동해삼육고)
  studentId String      @unique // 학번
  name      String      // 성명
  password  String      // scrypt 해시
  posts     BoardPost[]
  createdAt DateTime    @default(now())
}

// 대용량 링크 (구글드라이브 등 외부 링크만 저장)
model DriveLink {
  id                Int      @id @default(autoincrement())
  title             String   // 자료 제목
  url               String   // 외부 링크 (구글드라이브 등)
  note              String? // 간단 설명(선택)
  uploaderStudentId String?
  uploaderName      String?
  createdAt         DateTime @default(now())
}

// 자료실 파일 (실제 파일은 Vercel Blob에 저장, 여기엔 정보만)
model FileItem {
  id                Int      @id @default(autoincrement())
  name              String   // 원본 파일명
  url               String   // Blob 다운로드 URL
  pathname          String   // Blob 경로 (삭제용)
  size              Int      // 파일 크기(바이트)
  uploaderStudentId String? // 올린 사람 학번
  uploaderName      String? // 올린 사람 이름
  subjectSlug       String? // 과목 수업자료면 과목 slug, 일반 자료실이면 null
  createdAt         DateTime @default(now())
}

// 메일 보내기 기록 (버튼 클릭 시 남는 로그)
model SentMail {
  id         Int      @id @default(autoincrement())
  studentId  String? // 보낸 사람 학번(로그인 시). 본인 기록만 조회하는 기준
  senderName String? // 로그인 시 이름, 아니면 비움
  toEmail    String   // 받는 사람
  subject    String   // 제목
  method     String   // "gmail" 또는 "outlook"
  createdAt  DateTime @default(now())
}

// 실시간 채팅 메시지
model ChatMessage {
  id        Int      @id @default(autoincrement())
  studentId String   // 작성자 학번
  name      String   // 작성자 이름
  content   String   // 메시지 내용 (이미지만 보낼 땐 빈 문자열)
  imagePath String? // 첨부 이미지의 Blob 경로 (있으면 그림 표시)
  createdAt DateTime @default(now())
}

// 학습 소감 게시글 (작성자 본인만 열람 가능)
model BoardPost {
  id        Int      @id @default(autoincrement())
  subject   String   // 과목
  title     String
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  praise    String? // 교사 칭찬 스탬프 (예: ⭐/👍/💯), 없으면 null
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 과목별 공지사항 (intro 페이지에서 등록 → 과목 페이지에 표시)
model Notice {
  id        Int      @id @default(autoincrement())
  slug      String   // 과목 slug (ai/programming/graphics/data-science)
  title     String
  content   String
  createdAt DateTime @default(now())
}

// 교사(관리자)가 다는 댓글
model Comment {
  id         Int      @id @default(autoincrement())
  postId     Int      // 대상 게시글
  authorName String   // 작성자 이름(교사)
  content    String
  createdAt  DateTime @default(now())
}

// ───────────── 가계365 (가계부) ─────────────
model GagyeTx {
  id          Int      @id @default(autoincrement())
  date        String   // YYYY-MM-DD (한국 시간 기준)
  year        Int
  month       Int
  type        String   // 수입 | 지출 | 저축
  major       String   // 대분류
  minor       String   @default("") // 소분류
  content     String   @default("") // 내용/사용처
  amount      Int
  payment     String   @default("")
  nature      String   @default("") // 고정지출 | 변동지출 | 낭비지출
  memo        String   @default("")
  receiptId   Int?
  recurringId Int?
  createdAt   DateTime @default(now())

  @@index([year, month])
  @@index([date])
}

model GagyeReceipt {
  id        Int      @id @default(autoincrement())
  mime      String
  data      String   // base64 (압축된 이미지 또는 PDF)
  createdAt DateTime @default(now())
}

model GagyeRecurring {
  id        Int      @id @default(autoincrement())
  active    Boolean  @default(true)
  type      String
  major     String
  minor     String   @default("")
  content   String   @default("")
  amount    Int
  payment   String   @default("")
  nature    String   @default("")
  day       Int      // 1~31 (31 = 말일)
  start     String   // YYYY-MM
  end       String   @default("") // YYYY-MM, 비우면 계속
  last      String   @default("") // 마지막으로 기록한 YYYY-MM
  createdAt DateTime @default(now())
}

model GagyeSetting {
  key   String @id
  value String // JSON
}
